# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_ACCESS_TOKEN: Permanent or System User Access Token from Meta Business Suite / WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="EAA..."

# WHATSAPP_PHONE_NUMBER_ID: Phone number ID assigned in Meta WhatsApp Business dashboard.
WHATSAPP_PHONE_NUMBER_ID="1000..."

# WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account ID (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID="2000..."

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Secret verification token configured in Meta App Webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="anujay_clinic_webhook_2026"

# VITE_API_BASE_URL: (Optional) When deploying static frontend to GitHub Pages with backend on Render/Fly/Railway.
# If omitted or empty, frontend calls relative /api/* (same domain).
VITE_API_BASE_URL=""

